# Dead Reckoning — local development configuration inventory
# Copy without overwriting an existing local file: cp -n .env.example .env
# Fill blanks locally. Keep .env private; never put server secrets in VITE_* vars.
# The DR services, config loader and console export are still planned, not built.
# This file documents their intended settings; copying it does not start the app.
# Source of truth: docs/implementation/CONTRACTS.md, section 8.
#
# Process scope matters: do not export this entire file to every service/child.
# During OpenBot setup, copy only its section plus DR_INTERNAL_TOKEN into the
# exported apps/console/.env. OpenBot does not automatically read this root file.
# The supervisor must explicitly allowlist the runner's provider/model settings
# and limited desk credential; no RawTree, OpenBot, Intelligence or operator keys.

# --- RawTree: control process only; canonical mission/evidence persistence ---
RAWTREE_API_KEY=
RAWTREE_DATABASE=deadreckoning

# --- Nimble: runner; live source extraction ---
NIMBLE_API_KEY=

# --- OpenAI: runner; application planner, separate from Claude developer models ---
OPENAI_API_KEY=
# Required: select an available Responses model and pin it after the Phase 0 probe.
# An empty value must fail configuration validation, never silently pick a model.
DR_PLANNER_MODEL=

# --- Liquid: runner; local llama-server, no hosted API key required ---
# Start the server separately on loopback with verified weights/build/schema support.
# DR_LIQUID_MODEL must match the actual served model name or configured alias.
DR_LIQUID_BASE_URL=http://127.0.0.1:8080/v1
DR_LIQUID_MODEL=LFM2.5-1.2B-Instruct

# --- DR runtime: proposed settings to wire into the validated config module ---
# Control/desk listeners must bind to 127.0.0.1 in code; a URL/port is not a bind rule.
DR_CONTROL_PORT=4400
DR_WORLD_BASE_URL=http://127.0.0.1:4401
# Total planner input budget, including instructions, schemas and current state.
DR_PLANNER_CONTEXT_BUDGET=6000
# Enable only for the local authenticated crash/world-edit demonstration.
DR_ENABLE_DEMO_CONTROLS=false

# --- Service authentication: generate three distinct local secrets ---
# For each token below, run openssl rand -hex 32 locally and store the result only
# in private environment files. Do not reuse provider keys or the encryption key.
# Shared by OpenBot server and DR control for proxy/run verification; never runner.
DR_INTERNAL_TOKEN=
# Local operator tooling and control/world services; never runner or public feed.
DR_OPERATOR_TOKEN=
# Desk and authorized control/runner clients; booking/lookup only, not world edits.
DR_WORLD_TOKEN=

# --- OpenBot console/server: settings verified against the pinned upstream source ---
# Requires the exported apps/console workspace and planned dead-reckoning tenant.
# PostgreSQL for OpenBot identity/operations, separate from RawTree and desk SQLite.
# Supply your own local connection string, including its private credentials.
DATABASE_URL=
# Optional until running DB integration tests: must identify a separate test DB.
# Never reuse DATABASE_URL for this value.
TEST_DATABASE_URL=
# Required vault/signing key: generate locally with openssl rand -base64 32.
# Must decode to 32 bytes. Keep in OpenBot only; never copy into DR or its runner.
KEY_ENCRYPTION_KEY=

# Required managed CopilotKit Intelligence project configuration; backend only.
INTELLIGENCE_API_URL=https://api.intelligence.copilotkit.ai
INTELLIGENCE_GATEWAY_WS_URL=wss://realtime.intelligence.copilotkit.ai
INTELLIGENCE_API_KEY=
# Managed Intelligence does not require COPILOTKIT_LICENSE_TOKEN.

# Resolve relative to apps/console/server when using OpenBot's normal server launch.
# The dead-reckoning tenant directory must be created during console adoption.
TENANT_PACKAGE_DIR=../examples/dead-reckoning
DEAD_RECKONING_AG_UI_URL=http://127.0.0.1:4400/ag-ui
AGENT_ENDPOINT_ALLOWED_HOSTS=127.0.0.1:4400
OPENBOT_GENERATIVE_UI=false

# Both API port names must agree; Vite/start scripts read SERVER_PORT and APP_PORT.
PORT=3001
SERVER_PORT=3001
APP_PORT=3010
TRUSTED_ORIGINS=http://127.0.0.1:3010
# Local single-user mode treats every reachable visitor as an administrator.
# BEFORE starting: apply the planned Vite dev/preview and API loopback patches,
# align the Vite API proxy, and verify listeners. These values do not apply patches.
# Public/shared deployment requires real sign-in configuration instead of this mode.
OPENBOT_SINGLE_USER=true

# Only the read-only fixture feed may use a public tunnel for Nimble extraction.
# Never expose the console, control API, desk write routes or operator controls.
# Public feed URL/allowlist wiring belongs to Phase 0/1; no working tunnel is implied.
