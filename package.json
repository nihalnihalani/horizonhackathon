{
  "name": "dead-reckoning",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check:types": "node packages/shared/bin/check-types.mjs",
    "test:unit": "vitest run --exclude '**/*.recovery.test.ts'",
    "test:recovery": "vitest run .recovery.test.ts",
    "smoke:rawtree": "node packages/shared/bin/dr-run.mjs storage packages/storage/scripts/smoke-rawtree.ts",
    "smoke:nimble": "node packages/shared/bin/dr-run.mjs providers packages/providers/scripts/smoke-nimble.ts",
    "smoke:liquid": "node packages/shared/bin/dr-run.mjs providers packages/providers/scripts/smoke-liquid.ts",
    "smoke:planner": "node packages/shared/bin/dr-run.mjs providers packages/providers/scripts/smoke-planner.ts",
    "dev:desk": "node packages/shared/bin/dr-run.mjs desk packages/desk/src/server.ts",
    "dev:control": "node packages/shared/bin/dr-run.mjs control packages/control/src/server.ts",
    "dev:control-stub": "node packages/shared/bin/dr-run.mjs control packages/control/src/stub-server.ts",
    "demo:f3": "node packages/shared/bin/dr-run.mjs runner scripts/demo-f3.ts",
    "demo:f3b": "node packages/shared/bin/dr-run.mjs runner scripts/demo-f3.ts --variant=f3b",
    "demo:naive": "node packages/shared/bin/dr-run.mjs runner scripts/demo-naive.ts",
    "demo:numbers": "node packages/shared/bin/dr-run.mjs runner scripts/demo-numbers.ts",
    "check:lint": "node scripts/lint.mjs",
    "test:integration": "vitest run packages/control packages/desk packages/kernel packages/storage --exclude '**/*.recovery.test.ts'",
    "test:e2e": "node packages/shared/bin/dr-run.mjs shared scripts/e2e.ts",
    "test:smoke:live": "node scripts/smoke-live.mjs",
    "bench:paired": "node packages/shared/bin/dr-run.mjs shared bench/run-paired.ts",
    "bench:memory": "node packages/shared/bin/dr-run.mjs shared bench/memory-trace.ts",
    "demo:doctor": "node packages/shared/bin/dr-run.mjs shared scripts/doctor.ts",
    "dev:core": "node scripts/dev-core.mjs"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.59",
    "@ag-ui/encoder": "0.0.59",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "gpt-tokenizer": "^3.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
